{
  "index_patterns": ["siem-alerts-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s"
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text"
        },
        "evidence": {
          "type": "text"
        },
        "pipeline": {
          "type": "keyword"
        },
        "network": {
          "properties": {
            "bytes": {
              "type": "long"
            }
          }
        },
        "event": {
          "properties": {
            "kind": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "module": {
              "type": "keyword"
            },
            "dataset": {
              "type": "keyword"
            },
            "severity": {
              "type": "integer"
            }
          }
        },
        "rule": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            }
          }
        },
        "alert": {
          "properties": {
            "reason": {
              "type": "text"
            },
            "evidence": {
              "type": "text"
            },
            "count": {
              "type": "long"
            },
            "rule_ids": {
              "type": "keyword"
            }
          }
        },
        "window": {
          "properties": {
            "start": {
              "type": "date"
            },
            "end": {
              "type": "date"
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            }
          }
        },
        "destination": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "related": {
          "properties": {
            "ip": {
              "type": "ip"
            }
          }
        },
        "zeek": {
          "properties": {
            "scan": {
              "properties": {
                "unique_destination_ports": {
                  "type": "long"
                },
                "unique_destination_ips": {
                  "type": "long"
                }
              }
            },
            "volume": {
              "properties": {
                "direction": {
                  "type": "keyword"
                },
                "total_bytes": {
                  "type": "long"
                }
              }
            },
            "connection": {
              "properties": {
                "count": {
                  "type": "long"
                }
              }
            }
          }
        },
        "correlation": {
          "properties": {
            "type": {
              "type": "keyword"
            }
          }
        }
      }
    }
  },
  "priority": 500,
  "_meta": {
    "description": "Phase 3 alerts template for Flink-generated SIEM alerts."
  }
}
