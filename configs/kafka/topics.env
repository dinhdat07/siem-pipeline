# Kafka bootstrap
BOOTSTRAP_SERVER=${KAFKA_BOOTSTRAP_SERVERS_HOST:-localhost:9092}

# Main topic for parsed Zeek conn events
TOPIC_ZEEK_CONN=zeek.conn
TOPIC_ZEEK_CONN_PARTITIONS=3
TOPIC_ZEEK_CONN_RF=1

# Main topic for parsed Snort alert events
TOPIC_SNORT_ALERT=snort.alert
TOPIC_SNORT_ALERT_PARTITIONS=3
TOPIC_SNORT_ALERT_RF=1

# Alerts topic for downstream detections (Flink -> alerts)
TOPIC_ALERTS=siem.alerts
TOPIC_ALERTS_PARTITIONS=3
TOPIC_ALERTS_RF=1

# Kafka Connect internal topics
TOPIC_CONNECT_CONFIGS=connect-configs
TOPIC_CONNECT_CONFIGS_PARTITIONS=1
TOPIC_CONNECT_CONFIGS_RF=1

TOPIC_CONNECT_OFFSETS=connect-offsets
TOPIC_CONNECT_OFFSETS_PARTITIONS=3
TOPIC_CONNECT_OFFSETS_RF=1

TOPIC_CONNECT_STATUS=connect-status
TOPIC_CONNECT_STATUS_PARTITIONS=3
TOPIC_CONNECT_STATUS_RF=1

# Dead-letter topic for connector indexing failures
TOPIC_CONNECT_DLQ=siem.connect.dlq
TOPIC_CONNECT_DLQ_PARTITIONS=3
TOPIC_CONNECT_DLQ_RF=1
