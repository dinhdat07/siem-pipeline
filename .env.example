COMPOSE_PROJECT_NAME=siem-pipeline

# Compose profiles used for staged startup.
# Leave blank for manual service selection, or override per command.
# Examples:
#   COMPOSE_PROFILES=hot
#   COMPOSE_PROFILES=cold,detect
#   COMPOSE_PROFILES=hot,cold,detect
COMPOSE_PROFILES=

KAFKA_IMAGE=apache/kafka:4.1.2
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.17.3
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.17.3
FLINK_BASE_IMAGE=flink:1.19.2-scala_2.12-java17
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
ICEBERG_REST_IMAGE=apache/iceberg-rest-fixture:1.10.1
POSTGRES_IMAGE=postgres:17-alpine

FLINK_SQL_KAFKA_CONNECTOR_VERSION=3.2.0-1.19
ICEBERG_VERSION=1.10.1
ICEBERG_FLINK_RUNTIME_VERSION=1.19
HADOOP_VERSION=3.4.2

# Service ports
KAFKA_EXTERNAL_PORT=9092
FLINK_UI_PORT=8081
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
KAFKA_CONNECT_PORT=8083
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ICEBERG_REST_PORT=8181
POSTGRES_PORT=5432

# Runtime endpoints
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092
ELASTICSEARCH_URL=http://localhost:9200
CONNECT_URL=http://localhost:8083
KIBANA_URL=http://localhost:5601
FLINK_REST_URL=http://localhost:8081
POSTGRES_HOST=localhost
POSTGRES_URL=postgresql://siem:siem@localhost:5432/siem_benchmark
KAFKA_SCAN_STARTUP_MODE=earliest-offset
KAFKA_COLD_PATH_GROUP_ID_ZEEK=flink-cold-zeek
KAFKA_COLD_PATH_GROUP_ID_SNORT=flink-cold-snort

# Resource sizing
# Recommended server specs:
# - full demo: 4 vCPU / 8 GB RAM minimum, 6 vCPU / 12 GB recommended
# - hot-only or detect-only: 2 vCPU / 4 GB RAM minimum
# - cold-only: 2 vCPU / 4-6 GB RAM minimum
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
KAFKA_CONNECT_HEAP_OPTS=-Xms256m -Xmx256m
FLINK_JOBMANAGER_MEMORY=512m
FLINK_TASKMANAGER_MEMORY=768m
POSTGRES_SHARED_BUFFERS=256MB

FLINK_PARALLELISM=1
FLINK_TASK_SLOTS=4
FLINK_CHECKPOINT_INTERVAL=30s

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_REGION=us-east-1
MINIO_WAREHOUSE_BUCKET=warehouse
S3_ENDPOINT_HOST=http://localhost:9000
S3_ENDPOINT_INTERNAL=http://minio:9000
ICEBERG_WAREHOUSE=s3://warehouse/

ICEBERG_CATALOG_NAME=siem_iceberg
ICEBERG_NAMESPACE=siem
ICEBERG_TABLE=normalized_events
ICEBERG_REST_URI_HOST=http://localhost:8181
ICEBERG_REST_URI_INTERNAL=http://iceberg-rest:8181
ICEBERG_CATALOG_IMPL=org.apache.iceberg.jdbc.JdbcCatalog
ICEBERG_CATALOG_JDBC_URI=jdbc:sqlite:/tmp/iceberg_catalog.db
ICEBERG_CATALOG_JDBC_USER=user
ICEBERG_CATALOG_JDBC_PASSWORD=password
ICEBERG_CATALOG_JDBC_STRICT_MODE=true

# PostgreSQL benchmark baseline settings
POSTGRES_DB=siem_benchmark
POSTGRES_USER=siem
POSTGRES_PASSWORD=siem

# Benchmark defaults
BENCHMARK_START_STACK=1
BENCHMARK_AUTO_BUILD=1
BENCHMARK_RESULTS_DIR=benchmark/results
BENCHMARK_DATA_DIR=benchmark/generated
BENCHMARK_LOW_RESOURCE=0
BENCHMARK_QUERY_ITERATIONS=5
BENCHMARK_CONCURRENCY_LEVELS=1,5,10,25
BENCHMARK_CONCURRENT_QUERIES_PER_WORKER=5
BENCHMARK_WAIT_TIMEOUT_SEC=240
BENCHMARK_WAIT_INTERVAL_SEC=5

# Demo defaults used by scripts/demo/run-demo.sh
DEMO_MODE=full
DEMO_START_STACK=1
DEMO_AUTO_BUILD=1
DEMO_RESET_STACK=0
DEMO_RESET_VOLUMES=0
DEMO_RESET_JOBS=1
DEMO_IMPORT_KIBANA=1
DEMO_ENABLE_SMOKE_TESTS=0
DEMO_WAIT_TIMEOUT_SEC=240
DEMO_WAIT_INTERVAL_SEC=5
DEMO_KAFKA_SCAN_STARTUP_MODE=latest-offset
DEMO_POST_JOB_SUBMIT_SLEEP_SEC=8
DEMO_POST_REPLAY_SLEEP_SEC=10
