# Shared distributed SIEM settings for the 3-node Tailscale cluster.
SIEM_CLUSTER_MODE=distributed
COMPOSE_PROJECT_NAME=siem-distributed
SIEM_CLUSTER_NAME=siem-distributed
SIEM_CONTROL_NODE=dvm-sgp-02
SIEM_REMOTE_ROOT=/root/siem-pipeline
SIEM_SSH_KEY=/root/.ssh/siem_pipeline_ed25519
SIEM_SSH_USER=root

SIEM_NODE_1_NAME=dvm-sgp-02
SIEM_NODE_1_IP=100.76.241.30
SIEM_NODE_2_NAME=dvm-sgp-01
SIEM_NODE_2_IP=100.123.190.84
SIEM_NODE_3_NAME=dvm-sgp-03
SIEM_NODE_3_IP=100.90.64.86

KAFKA_IMAGE=apache/kafka:4.1.2
KAFKA_CLUSTER_ID=V8Xx02BWSn25efJMTJr8sA
KAFKA_CONTROLLER_QUORUM_VOTERS=1@100.76.241.30:19093,2@100.123.190.84:19093,3@100.90.64.86:19093
KAFKA_BOOTSTRAP_SERVERS_HOST=100.76.241.30:19092,100.123.190.84:19092,100.90.64.86:19092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=100.76.241.30:19092,100.123.190.84:19092,100.90.64.86:19092
KAFKA_NUM_PARTITIONS=12
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2

ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.17.3
ELASTICSEARCH_CLUSTER_NAME=siem-es-distributed
ELASTICSEARCH_SEED_HOSTS=100.76.241.30:19300,100.123.190.84:19300,100.90.64.86:19300
ELASTICSEARCH_INITIAL_MASTER_NODES=dvm-sgp-02-es,dvm-sgp-01-es,dvm-sgp-03-es
ELASTICSEARCH_URL=http://100.76.241.30:19200
ELASTICSEARCH_CONNECT_URL=http://100.76.241.30:19200,http://100.123.190.84:19200,http://100.90.64.86:19200
ELASTICSEARCH_JAVA_OPTS='-Xms768m -Xmx768m'
ELASTICSEARCH_MEM_LIMIT=1536m

KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.17.3
KIBANA_URL=http://100.76.241.30:15601

CONNECT_URL=http://100.123.190.84:18083
KAFKA_CONNECT_HEAP_OPTS='-Xms384m -Xmx384m'

FLINK_BASE_IMAGE=flink:1.19.2-scala_2.12-java17
FLINK_SQL_KAFKA_CONNECTOR_VERSION=3.2.0-1.19
ICEBERG_VERSION=1.10.1
ICEBERG_FLINK_RUNTIME_VERSION=1.19
HADOOP_VERSION=3.4.2
FLINK_REST_URL=http://100.76.241.30:18081
FLINK_JOBMANAGER_RPC_ADDRESS=100.76.241.30
FLINK_JOBMANAGER_MEMORY=1600m
FLINK_TASKMANAGER_MEMORY=1024m
FLINK_TASK_SLOTS=2
FLINK_PARALLELISM=4
FLINK_CHECKPOINT_INTERVAL=30s
FLINK_CHECKPOINT_DIR=s3://warehouse/flink/checkpoints
FLINK_SAVEPOINT_DIR=s3://warehouse/flink/savepoints

MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_REGION=us-east-1
MINIO_WAREHOUSE_BUCKET=warehouse
S3_ENDPOINT_HOST=http://100.76.241.30:19000
S3_ENDPOINT_INTERNAL=http://100.76.241.30:19000
ICEBERG_WAREHOUSE=s3://warehouse/

ICEBERG_REST_BASE_IMAGE=apache/iceberg-rest-fixture:1.10.1
ICEBERG_REST_IMAGE=siem/iceberg-rest-postgres:1.10.1
POSTGRES_JDBC_VERSION=42.7.7
ICEBERG_REST_URI_HOST=http://100.76.241.30:18181
ICEBERG_REST_URI_INTERNAL=http://100.76.241.30:18181
ICEBERG_CATALOG_NAME=siem_iceberg
ICEBERG_NAMESPACE=siem
ICEBERG_TABLE=normalized_events
ICEBERG_CATALOG_IMPL=org.apache.iceberg.jdbc.JdbcCatalog
ICEBERG_CATALOG_JDBC_URI=jdbc:postgresql://100.76.241.30:15432/iceberg_catalog
ICEBERG_CATALOG_JDBC_USER=iceberg
ICEBERG_CATALOG_JDBC_PASSWORD=iceberg
ICEBERG_CATALOG_JDBC_STRICT_MODE=true

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=siem_benchmark
POSTGRES_USER=siem
POSTGRES_PASSWORD=siem
POSTGRES_HOST=100.76.241.30
POSTGRES_URL=postgresql://siem:siem@100.76.241.30:15432/siem_benchmark
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_TEMP_FILE_LIMIT=10GB

BENCHMARK_START_STACK=0
BENCHMARK_AUTO_BUILD=0
BENCHMARK_ES_SHARDS=3
BENCHMARK_ES_REPLICAS=1
BENCHMARK_ES_BULK_CHUNK_BYTES=16777216
BENCHMARK_CONCURRENCY_LEVELS=1,5,10,25
BENCHMARK_QUERY_ITERATIONS=5
BENCHMARK_CONCURRENT_QUERIES_PER_WORKER=5
BENCHMARK_WAIT_TIMEOUT_SEC=600
ELASTICSEARCH_INDEX_SHARDS=3
ELASTICSEARCH_INDEX_REPLICAS=1
# Side-by-side host ports chosen to avoid ecommerce-lakehouse ports.
KAFKA_BROKER_PORT=19092
KAFKA_CONTROLLER_PORT=19093
ELASTICSEARCH_HTTP_PORT=19200
ELASTICSEARCH_TRANSPORT_PORT=19300
KIBANA_PORT=15601
KAFKA_CONNECT_PORT=18083
FLINK_UI_PORT=18081
FLINK_JOBMANAGER_RPC_PORT=16123
FLINK_BLOB_PORT=16124
FLINK_TASKMANAGER_DATA_PORT=16121
FLINK_TASKMANAGER_RPC_PORT=16122
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
ICEBERG_REST_PORT=18181
POSTGRES_PORT=15432
KAFKA_CONTAINER=siem-kafka
MINIO_CONTAINER=siem-minio
FLINK_JOBMANAGER_CONTAINER=siem-flink-jobmanager

POSTGRES_CONTAINER=siem-postgres
